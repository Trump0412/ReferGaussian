+    def get_temporal_activity(self):
+        if self.get_xyz.shape[0] == 0:
+            return torch.empty((0,), device="cuda")
+
+        speed = torch.norm(self.get_time_velocity, dim=-1)
+        acceleration = torch.norm(self.get_time_acceleration, dim=-1)
+        scale = self.get_time_scale.squeeze(-1)
+        anchor_offset = (self.get_time_anchor.squeeze(-1) - 0.5).abs() * 2.0
