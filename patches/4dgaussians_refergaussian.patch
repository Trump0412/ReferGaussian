+    def _compute_temporal_worldtube_support(self, indices=None):
+        time_scale = self.get_time_scale if indices is None else self.get_time_scale[indices]
+        time_velocity = self.get_time_velocity if indices is None else self.get_time_velocity[indices]
+        time_acceleration = self.get_time_acceleration if indices is None else self.get_time_acceleration[indices]
+        opacity = self.get_opacity if indices is None else self.get_opacity[indices]
+        spatial_extent = self.get_scaling.max(dim=1, keepdim=True).values
+        if indices is not None:
+            spatial_extent = spatial_extent[indices]
+        spatial_extent = spatial_extent.clamp_min(1.0e-4)
+
+        speed = torch.norm(time_velocity, dim=-1, keepdim=True)
+        acceleration = torch.norm(time_acceleration, dim=-1, keepdim=True)
+        safe_scale = time_scale.clamp_min(1.0e-4)
+        tube_span = max(self.temporal_worldtube_span, 1.0e-4)
+        base_support = safe_scale * tube_span
+        base_drift = speed * base_support
+        if self.temporal_acceleration_enabled:
+            base_drift = base_drift + 0.5 * acceleration * base_support.square()
+        base_ratio = base_drift / spatial_extent
+
+        if self.temporal_worldtube_lite:
+            support_factor = torch.ones_like(base_ratio)
+            effective_scale = safe_scale
+            effective_support = base_support
+            effective_drift = base_drift
+            effective_ratio = base_ratio
+            visibility_proxy = torch.ones_like(base_ratio)
+            occupancy_mass = effective_support
+            return {
+                "safe_scale": safe_scale,
+                "spatial_extent": spatial_extent,
+                "speed": speed,
+                "acceleration": acceleration,
+                "visibility_proxy": visibility_proxy,
+                "base_support": base_support,
+                "base_ratio": base_ratio,
+                "support_factor": support_factor,
+                "effective_scale": effective_scale,
+                "effective_support": effective_support,
+                "effective_drift": effective_drift,
+                "effective_ratio": effective_ratio,
+                "occupancy_mass": occupancy_mass,
+            }
+
+        visibility_mix = float(self.temporal_worldtube_visibility_mix)
+        visibility_proxy = ((1.0 - visibility_mix) + visibility_mix * opacity).clamp_min(1.0e-3)
+
+        support_factor = torch.ones_like(base_ratio)
+        if self.temporal_worldtube_adaptive_support:
+            target_ratio = max(self.temporal_worldtube_ratio_target, 1.0e-4)
+            ratio_error = (target_ratio - base_ratio) / target_ratio
+            support_factor = 1.0 + self.temporal_worldtube_support_gain * ratio_error * visibility_proxy
+            min_factor = min(self.temporal_worldtube_support_min_factor, self.temporal_worldtube_support_max_factor)
+            max_factor = max(self.temporal_worldtube_support_min_factor, self.temporal_worldtube_support_max_factor)
+            support_factor = support_factor.clamp(min=min_factor, max=max_factor)
+
+        effective_scale = safe_scale * support_factor
+        effective_support = effective_scale * tube_span
+        effective_drift = speed * effective_support
+        if self.temporal_acceleration_enabled:
+            effective_drift = effective_drift + 0.5 * acceleration * effective_support.square()
+        effective_ratio = effective_drift / spatial_extent
+        occupancy_mass = effective_support * (1.0 + effective_ratio) * visibility_proxy
+
+        return {
+            "safe_scale": safe_scale,
+            "spatial_extent": spatial_extent,
+            "speed": speed,
+            "acceleration": acceleration,
+            "visibility_proxy": visibility_proxy,
+            "base_support": base_support,
+            "base_ratio": base_ratio,
+            "support_factor": support_factor,
+            "effective_scale": effective_scale,
+            "effective_support": effective_support,
+            "effective_drift": effective_drift,
+            "effective_ratio": effective_ratio,
+            "occupancy_mass": occupancy_mass,
+        }
+
+    def get_temporal_worldtube_statistics(self):
+        if self.get_xyz.shape[0] == 0:
+            empty = torch.empty((0,), device="cuda")
+            zero = torch.zeros((), device="cuda")
+            return {
+                "support": empty,
+                "spatial_extent": empty,
+                "drift_extent": empty,
+                "tube_ratio": empty,
+                "complexity": empty,
+                "support_loss": zero,
+                "ratio_loss": zero,
+                "support_mean": zero,
+                "support_max": zero,
+                "tube_ratio_mean": zero,
+                "tube_ratio_max": zero,
+                "support_factor_mean": zero,
+                "support_factor_max": zero,
+                "occupancy_mean": zero,
+                "occupancy_max": zero,
+                "visibility_mean": zero,
+                "visibility_max": zero,
+            }
+
+        support_state = self._compute_temporal_worldtube_support()
+        support = support_state["effective_support"].squeeze(-1)
+        tube_ratio = support_state["effective_ratio"].squeeze(-1)
+        occupancy = support_state["occupancy_mass"].squeeze(-1)
+        visibility = support_state["visibility_proxy"].squeeze(-1)
+
+        support_min = min(self.temporal_worldtube_support_min, self.temporal_worldtube_support_max)
+        support_max = max(self.temporal_worldtube_support_min, self.temporal_worldtube_support_max)
+        support_loss = (
+            F.relu(support_min - support).square()
+            + F.relu(support - support_max).square()
+        ).mean()
+
+        ratio_delta = (tube_ratio - self.temporal_worldtube_ratio_target).abs()
+        ratio_loss = F.relu(ratio_delta - self.temporal_worldtube_ratio_tolerance).square().mean()
+
+        complexity = support * (1.0 + tube_ratio)
+        complexity = complexity / complexity.mean().clamp_min(1.0e-6)
+        return {
+            "support": support,
+            "spatial_extent": support_state["spatial_extent"].squeeze(-1),
+            "drift_extent": support_state["effective_drift"].squeeze(-1),
+            "tube_ratio": tube_ratio,
+            "complexity": complexity,
+            "support_loss": support_loss,
+            "ratio_loss": ratio_loss,
+            "support_mean": support.mean(),
+            "support_max": support.max(),
+            "tube_ratio_mean": tube_ratio.mean(),
+            "tube_ratio_max": tube_ratio.max(),
+            "support_factor_mean": support_state["support_factor"].mean(),
+            "support_factor_max": support_state["support_factor"].max(),
+            "occupancy_mean": occupancy.mean(),
+            "occupancy_max": occupancy.max(),
+            "visibility_mean": visibility.mean(),
+            "visibility_max": visibility.max(),
