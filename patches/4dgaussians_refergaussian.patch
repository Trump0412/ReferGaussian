+def voxel_downsample(vertices, voxel_size):
+    coords = np.stack([vertices["x"], vertices["y"], vertices["z"]], axis=1).astype(np.float64)
+    voxel_ids = np.floor(coords / voxel_size).astype(np.int64)
+    _, keep_indices = np.unique(voxel_ids, axis=0, return_index=True)
+    keep_indices = np.sort(keep_indices)
+    return vertices[keep_indices]
+
+
+def write_ply_like(source_ply, vertices, output_file):
+    elements = []
+    for element in source_ply.elements:
+        if element.name == "vertex":
+            elements.append(PlyElement.describe(vertices, "vertex", comments=element.comments))
+        else:
+            elements.append(element)
+    ply = PlyData(
+        elements,
+        text=source_ply.text,
+        byte_order=source_ply.byte_order,
+        comments=source_ply.comments,
+        obj_info=source_ply.obj_info,
+    )
+    ply.write(output_file)
