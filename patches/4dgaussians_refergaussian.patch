+import os
+import sys
+from copy import deepcopy
+
+
+def _deep_merge(base, override):
+    if isinstance(base, dict) and isinstance(override, dict):
+        merged = {key: deepcopy(value) for key, value in base.items()}
+        for key, value in override.items():
+            if key in merged:
+                merged[key] = _deep_merge(merged[key], value)
+            else:
+                merged[key] = deepcopy(value)
+        return merged
+    return deepcopy(override)
+
+
+def _exec_config(config_path):
+    namespace = {"__file__": config_path}
+    with open(config_path, "r", encoding="utf-8") as handle:
+        source = handle.read()
+    exec(compile(source, config_path, "exec"), namespace)
+    return {key: value for key, value in namespace.items() if not key.startswith("__")}
+
+
+def load_config_dict(config_path):
+    config_path = os.path.abspath(config_path)
+    payload = _exec_config(config_path)
+    base_spec = payload.pop("_base_", None)
+
+    merged = {}
+    if base_spec:
+        if isinstance(base_spec, str):
+            base_list = [base_spec]
+        else:
+            base_list = list(base_spec)
+        for base_item in base_list:
+            base_path = os.path.join(os.path.dirname(config_path), base_item)
+            merged = _deep_merge(merged, load_config_dict(base_path))
+
+    return _deep_merge(merged, payload)
+
+
+def _cli_override_keys(argv):
+    override_keys = set()
+    for token in argv:
+        if not token.startswith("--") or token == "--":
+            continue
+        key = token[2:].split("=", 1)[0].replace("-", "_")
+        if key:
+            override_keys.add(key)
+    return override_keys
+
+
+def apply_config_file(args, config_path):
+    from utils.params_utils import merge_hparams
+
+    config = load_config_dict(config_path)
+    return merge_hparams(args, config, preserve_keys=_cli_override_keys(sys.argv[1:]))
