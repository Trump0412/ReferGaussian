+
+    def temporal_extent_regularization(self):
+        speed = torch.norm(self.get_time_velocity, dim=-1)
+        acceleration = torch.norm(self.get_time_acceleration, dim=-1)
+        reg = {
+            "velocity": speed.square().mean(),
+            "acceleration": acceleration.square().mean(),
+            "speed_mean": speed.mean(),
+            "speed_max": speed.max() if speed.numel() > 0 else torch.zeros((), device=self.get_xyz.device),
+            "acceleration_mean": acceleration.mean(),
+            "acceleration_max": acceleration.max() if acceleration.numel() > 0 else torch.zeros((), device=self.get_xyz.device),
+        }
+        if self.temporal_worldtube_enabled:
+            reg.update(self.get_temporal_worldtube_statistics())
+        else:
+            zero = torch.zeros((), device=self.get_xyz.device)
+            reg.update(
+                {
+                    "support_loss": zero,
+                    "ratio_loss": zero,
+                    "support_mean": zero,
+                    "support_max": zero,
+                    "tube_ratio_mean": zero,
+                    "tube_ratio_max": zero,
+                    "support_factor_mean": zero,
+                    "support_factor_max": zero,
+                    "occupancy_mean": zero,
+                    "occupancy_max": zero,
+                    "visibility_mean": zero,
+                    "visibility_max": zero,
+                }
+            )
+        return reg
